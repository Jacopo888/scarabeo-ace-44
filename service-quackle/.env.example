# Comma-separated list of allowed origins for browser requests
CORS_ORIGINS=https://preview--scarabeo-ace-44.lovable.app,https://scarabeo-ace-44.lovable.app

# Environment mode (prod, dev, staging) - affects debug endpoint visibility
ENV=dev

# Enable debug endpoints (/debug/*) even in production (1|true|yes|on to enable)
# By default, debug routes are auto-enabled in non-prod environments
DEBUG_ROUTES=false

# Quackle runtime (Storico Railway)
QUACKLE_LEXDIR=/data/lexica
QUACKLE_APPDATA_DIR=/data/appdata
QUACKLE_LEXICON=enable1.15
LEXICON_NAME=enable1.15
# Optional bootstrap sources
DAWG_URL=https://raw.githubusercontent.com/Jacopo888/quackle/master/data/lexica/enable1.15.dawg
GADDAG_URL=https://raw.githubusercontent.com/Jacopo888/quackle/master/data/lexica/enable1.15.gaddag
