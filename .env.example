# Copy this file to .env for local development.
# Do not commit .env, .env.development, or .env.production.

# Supabase frontend config. The publishable anon key is public, but it should
# still be configured through env so projects/environments can be swapped safely.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Local rating API. Heroku/production can set this as a config var.
VITE_RATING_API_URL=http://localhost:4000

# Quackle service used by production builds and Heroku.
VITE_QUACKLE_SERVICE_URL=https://service-quackle-6773ae98281f.herokuapp.com

# Debug logs for Quackle and moves. Set to false to silence logs for end users.
VITE_DEBUG_QUACKLE=
