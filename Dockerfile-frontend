FROM node:20-bookworm-slim AS build
ARG VITE_QUACKLE_SERVICE_URL
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_BOARD_SCHEMA=coord_map_1based
ENV VITE_QUACKLE_SERVICE_URL=$VITE_QUACKLE_SERVICE_URL \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY \
    VITE_BOARD_SCHEMA=$VITE_BOARD_SCHEMA
ENV npm_config_fetch_retry_maxtimeout=120000 \
    npm_config_fetch_retries=5 \
    npm_config_fetch_retry_mintimeout=2000
WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build:prod

FROM nginx:alpine
# Install envsubst for templating Nginx config at runtime
RUN apk add --no-cache gettext
COPY default.conf.template /etc/nginx/conf.d/default.conf.template
COPY --from=build /app/dist /usr/share/nginx/html
CMD sh -c 'envsubst '\''$PORT'\'' < /etc/nginx/conf.d/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g "daemon off;"'
